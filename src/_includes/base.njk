<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} · {% endif %}Ethan Shanfeld</title>
  <meta name="description" content="{{ description or 'Writing by Ethan Shanfeld.' }}">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body>
  <header class="topbar">
    <a class="wordmark" href="{{ '/' | url }}">Ethan Shanfeld</a>
    <nav>
      <a href="{{ '/' | url }}"{% if title == "Home" %} class="current"{% endif %}>Work</a>
      <a href="{{ '/about/' | url }}"{% if title == "About" %} class="current"{% endif %}>About</a>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="foot">
    <span>&copy; {{ currentYear }} Ethan Shanfeld</span>
    <a href="mailto:ethanshanfeld@gmail.com">ethanshanfeld@gmail.com</a>
  </footer>
</body>
</html>

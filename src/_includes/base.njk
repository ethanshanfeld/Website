<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} · {% endif %}Ethan Shanfeld</title>
  <meta name="description" content="{{ description or 'Writing by Ethan Shanfeld.' }}">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <a class="site-title" href="/">Ethan Shanfeld</a>
    <nav class="site-nav">
      <a href="/">Home</a>
      <a href="/about/">About</a>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>&copy; {{ currentYear }} Ethan Shanfeld</p>
  </footer>

  <script src="/js/cursor.js" defer></script>
</body>
</html>
